# Copie este arquivo para .env (cp .env.example .env)
# As portas abaixo são as do docker-compose.yml.
# Se for usar o Postgres/Mongo instalados direto na máquina, troque para 5432 e 27017.

PG_HOST=localhost
PG_PORT=5433
PG_USER=petshop
PG_PASSWORD=petshop
PG_DATABASE=petshop

MONGO_URL=mongodb://localhost:27018
MONGO_DATABASE=petshop
